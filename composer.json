{
    "name": "antistatique/swisstopo",
    "description": "Convert GPS (WGS84) to Swiss (LV03 and LV95) coordinates (and vice versa)",
    "type": "library",
    "keywords": [
        "swisstopo",
        "switzerland",
        "coordinates",
        "wgs84",
        "lv03",
        "lv95",
        "ch1903",
        "gps",
        "converter"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.21",
        "php-coveralls/php-coveralls": "^2.1",
        "phpmd/phpmd": "^2.8",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/php-code-coverage": "^14",
        "phpunit/phpunit": "^13",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Antistatique\\Swisstopo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antistatique\\Swisstopo\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Antistatique SA",
            "email": "info@antistatique.net",
            "homepage": "https://www.antistatique.net",
            "role": "Sponsor"
        },
        {
            "name": "Kevin Wenger",
            "email": "contact@kevin-wenger.ch",
            "homepage": "http://kevin-wenger.ch",
            "role": "Author & Maintainer"
        }
    ],
    "homepage": "https://github.com/antistatique/swisstopo",
    "support": {
        "issues": "https://github.com/antistatique/swisstopo/issues",
        "source": "https://github.com/antistatique/swisstopo"
    },
    "config": {
        "sort-packages": true
    }
}
